{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "instagram-kit.html", "use": "@vercel/static" },
    { "src": "favicon.ico", "use": "@vercel/static" },
    { "src": "robots.txt", "use": "@vercel/static" },
    { "src": "sitemap.xml", "use": "@vercel/static" },
    { "src": "icons/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/superadmin/(.*)", "dest": "https://admin.jclagencia.com/api/superadmin/$1" },
    { "src": "/superadmin", "dest": "https://admin.jclagencia.com/superadmin" },
    { "src": "/superadmin/(.*)", "dest": "https://admin.jclagencia.com/superadmin/$1" },
    { "src": "/_next/(.*)", "dest": "https://admin.jclagencia.com/_next/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
