{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "pagar.html",
      "use": "@vercel/static"
    },
    {
      "src": "instagram-kit.html",
      "use": "@vercel/static"
    },
    {
      "src": "paginas.css",
      "use": "@vercel/static"
    },
    {
      "src": "facturacion-electronica-pos.html",
      "use": "@vercel/static"
    },
    {
      "src": "menu-digital-qr.html",
      "use": "@vercel/static"
    },
    {
      "src": "sistema-pos-bares.html",
      "use": "@vercel/static"
    },
    {
      "src": "sistema-pos-cafeterias.html",
      "use": "@vercel/static"
    },
    {
      "src": "sistema-pos-comidas-rapidas.html",
      "use": "@vercel/static"
    },
    {
      "src": "software-restaurantes-sogamoso.html",
      "use": "@vercel/static"
    },
    {
      "src": "software-a-la-medida.html",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "sitemap.xml",
      "use": "@vercel/static"
    },
    {
      "src": "icons/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/pagar",
      "dest": "/pagar.html"
    },
    {
      "src": "/facturacion-electronica-pos/?",
      "dest": "/facturacion-electronica-pos.html"
    },
    {
      "src": "/menu-digital-qr/?",
      "dest": "/menu-digital-qr.html"
    },
    {
      "src": "/sistema-pos-bares/?",
      "dest": "/sistema-pos-bares.html"
    },
    {
      "src": "/sistema-pos-cafeterias/?",
      "dest": "/sistema-pos-cafeterias.html"
    },
    {
      "src": "/sistema-pos-comidas-rapidas/?",
      "dest": "/sistema-pos-comidas-rapidas.html"
    },
    {
      "src": "/software-restaurantes-sogamoso/?",
      "dest": "/software-restaurantes-sogamoso.html"
    },
    {
      "src": "/software-a-la-medida/?",
      "dest": "/software-a-la-medida.html"
    },
    {
      "src": "/q/(.*)",
      "dest": "https://admin.jclagencia.com/q/$1"
    },
    {
      "src": "/api/superadmin/(.*)",
      "dest": "https://admin.jclagencia.com/api/superadmin/$1"
    },
    {
      "src": "/superadmin",
      "dest": "https://admin.jclagencia.com/superadmin"
    },
    {
      "src": "/superadmin/(.*)",
      "dest": "https://admin.jclagencia.com/superadmin/$1"
    },
    {
      "src": "/_next/(.*)",
      "dest": "https://admin.jclagencia.com/_next/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
